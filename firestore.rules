// Sauvegarde ce fichier et déploie: firebase deploy --only firestore:rules

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return request.auth.token.admin == true;
    }

    // Admin-only collections
    match /ncnda/{docId} {
      allow read, write: if isAdmin();
    }
    match /psa/{docId} { // Profit-Sharing Agreements
      allow read, write: if isAdmin();
    }
    match /proformas/{docId} {
      allow read, write: if isAdmin();
    }
    match /quotations/{docId} {
      allow read, write: if isAdmin();
    }
    match /product_specs/{docId} {
      allow read: if true;           // public: visible côté vitrine
      allow create, update, delete: if isAdmin();
    }

    // Contact form submissions: création ouverte (site public) + lecture admin
    match /contact_requests/{docId} {
      allow create: if true; // visiteurs peuvent écrire
      allow read, update, delete: if isAdmin();
    }

    // Legacy collections (maintenir compatibilité)
    match /contacts/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    match /docs/{id} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}